# Template for a REAL Confidential Space deployment (TEE_PROFILE=confidential-space).
# Copy to .env.<chain>, fill in the keys, then activate with:
#   ./scripts/use-chain.sh <chain>
#
# In this profile the extension image runs on a GCP Confidential Space VM with
# hardware attestation. MODE=0 is baked into the image and deliberately NOT
# launch-overridable. The proxy config mounted by compose must be fail-closed
# with the FULL posture set — start-services.sh refuses the profile otherwise:
#   [attestation] enable = true, allow_magic_pass = false, and non-empty
#   expected_code_hashes, expected_platforms, expected_debug_statuses and
#   audience, plus a non-zero max_token_age and require_sec_boot = true.
# An empty list, an empty string, max_token_age = 0 or require_sec_boot = false
# makes the proxy SKIP that one check instead of reporting a misconfiguration.
# start-services.sh and post-build.sh fail fast when any of this is
# inconsistent. Walkthrough: docs/deployment-steps.md.

LANGUAGE=go

CHAIN=coston2
CHAIN_ID=114                  # REQUIRED — unset means chainID 0 and empty TEE signatures
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
EXT_PROXY_URL=                # public HTTPS URL of the proxy (handed back by the VM operator)

# --- Profile matrix: all four values are REQUIRED exactly as below -----------
TEE_PROFILE=confidential-space
LOCAL_MODE=false
SIMULATED_TEE=false
MODE=0                        # real Confidential Space attestation

TEE_VERSION=v0.1.0            # label allow-tee-version attaches to the allow-listed TEE
                              # IMAGE on-chain. NOT the extension version in
                              # go/internal/config/config.go (that one is hashed into
                              # stateVersion and stamped on every ActionResult); the two
                              # are independent and need not match.

# --- Keys — separate roles are mandatory here -------------------------------
DEPLOYMENT_PRIVATE_KEY=       # funded deployer; short-lived role, no 0x prefix
INITIAL_OWNER=                # 0x address derived from DEPLOYMENT_PRIVATE_KEY
PROXY_PRIVATE_KEY=            # separate UNFUNDED key for proxy /info signing — never the deployer
EXTENSION_OWNER_KEY=          # extension owner used by allow-tee-version; keep separate from deployer

# TEE governance signers — for a real deployment use more than one device/person
# GOVERNANCE_SIGNERS=0xAbc...,0xDef...
# GOVERNANCE_THRESHOLD=2
