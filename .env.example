# Template for chain-specific env files (see README "Deploying & Registering on Coston2").
# Copy to .env.<chain> (e.g. .env.coston2), fill in the keys, then activate with:
#   ./scripts/use-chain.sh <chain>
#
# THIS TEMPLATE IS THE SIMULATED TESTNET PROFILE (TEE_PROFILE=testnet-sim):
# the TEE runs as a plain local Docker container with MODE=1, i.e. simulated
# attestation (the tee-node magic_pass sentinel). Signatures from such a
# deployment prove NOTHING about the code that produced them — development and
# testing only; never fund it with real value. For a real deployment start
# from .env.confidential-space.example instead. start-services.sh and
# post-build.sh fail fast when this matrix is inconsistent.

# Extension implementation language (<dir>/language.env must exist)
LANGUAGE=go

CHAIN=coston2
CHAIN_ID=114                  # REQUIRED — unset means chainID 0 and every TEE signature comes back empty
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
EXT_PROXY_URL=                # leave empty — read from the running ngrok agent

# --- Profile matrix (validated fail-fast by scripts/lib/profile.sh) ----------
TEE_PROFILE=testnet-sim       # EXPLICIT opt-in: simulated TEE on a public testnet
LOCAL_MODE=false              # live chain: dev-key fallbacks off, secure-URL gates on
SIMULATED_TEE=true            # MUST agree with MODE. MODE=1 makes the node emit the
                              # magic_pass sentinel instead of a Confidential Space JWT;
                              # only the simulated register-tee path accepts that, so
                              # SIMULATED_TEE=false here makes register-tee try to parse
                              # "magic_pass" as a JWT and abort.
MODE=1                        # simulated attestation (magic_pass) — testnet-sim only.
                              # The mounted proxy config must set allow_magic_pass = true.
TEE_VERSION=v0.1.0            # label allow-tee-version attaches to the allow-listed TEE
                              # IMAGE on-chain. NOT the extension version in
                              # go/internal/config/config.go (that one is hashed into
                              # stateVersion and stamped on every ActionResult); the two
                              # are independent and need not match.

# --- Keys — keep the roles separate
DEPLOYMENT_PRIVATE_KEY=       # funded key for deployments and on-chain calls, no 0x prefix
INITIAL_OWNER=                # 0x address derived from DEPLOYMENT_PRIVATE_KEY
PROXY_PRIVATE_KEY=            # proxy /info signing key. Prefer a SEPARATE, unfunded key:
                              # it lives in a long-running network-facing service and only
                              # signs /info responses. Reusing the deployer key works but
                              # couples an online service key to your funds.

# Key used by allow-tee-version when the extension owner differs from the deployer
# EXTENSION_OWNER_KEY=

# Optional TEE governance (defaults: deployer as sole signer, threshold 1)
# GOVERNANCE_SIGNERS=0xAbc...,0xDef...
# GOVERNANCE_THRESHOLD=1
